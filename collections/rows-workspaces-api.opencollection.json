{
  "opencollection": "1.0.0",
  "info": {
    "name": "Rows Data Workspaces API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Workspaces",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List workspaces",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.rows.com/v1/workspaces"
          },
          "docs": "List the workspaces the authenticated API key can access."
        }
      ]
    }
  ],
  "bundled": true
}